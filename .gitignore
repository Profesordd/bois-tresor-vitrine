# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.vercel.tmp
!.env.local.example

# vercel
.vercel

# claude code project settings (may reference other projects' local config)
# On exclut le contenu et non le dossier : git ne redescend jamais dans un
# dossier exclu, et l'exception ci-dessous resterait sans effet.
.claude/*
# Exception : la documentation du projet doit voyager avec le dépôt, c'est
# elle qui explique les règles non évidentes à qui reprend le code.
!.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
